POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockai
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080
COMPOSE_PROJECT_NAME=stockai-pro

# API Keys (z root .env)
POLYGON_API_KEY=pk_...
EODHD_API_KEY=...
ALPHA_VANTAGE_KEY=...
FINNHUB_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=...

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@timescaledb:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:${REDIS_PORT}

NODE_ENV=development
PORT=3000
