# =============================================================================
# StockAI Pro - production environment template (NO REAL SECRETS)
# =============================================================================
# Copy to `.env.production` on the VPS (e.g. `/root/aplikacja-gielda/.env.production`).
# Used by: `docker-compose.prod.yml` (api service) and legacy `docker-compose.yml`.
#
# NEVER commit `.env.production` or paste real keys into git/issues/chat.
#
# Generate placeholders:
#   ENCRYPTION_SECRET:  openssl rand -hex 32    # must be exactly 64 hex chars (32 bytes)
#   JWT_SECRET:         openssl rand -base64 48  # long random string
#   INTERNAL_API_KEY:   openssl rand -hex 32
#
# After editing on VPS:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --force-recreate api
# See: docs/production-launch-smoke-checklist.md
# =============================================================================

NODE_ENV=production
PORT=3000

# --- Core infrastructure (passwords must match POSTGRES_PASSWORD in DATABASE_URL) ---
DATABASE_URL=postgresql://postgres:REPLACE_STRONG_PASSWORD@timescaledb:5432/stockai
REDIS_URL=redis://redis:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD

# --- Auth & encryption ---
# Required for login/register/JWT-protected routes.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Required for Autopilot broker credential encryption (apps/api/src/modules/autopilot/crypto.service.ts).
# MUST be exactly 64 hexadecimal characters encoding 32 bytes. Example format only - generate your own:
# ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_SECRET=REPLACE_WITH_64_HEX_CHARS

# --- Stripe (billing) ---
# Live keys from Stripe Dashboard. Webhook secret from Stripe -> Developers -> Webhooks.
# Price IDs from Products -> each price row (monthly/yearly for Pro and Pro+).
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE
STRIPE_PRO_YEARLY_PRICE_ID=price_REPLACE
# Code env names use PROPLUS (no underscore between PRO and PLUS):
STRIPE_PROPLUS_MONTHLY_PRICE_ID=price_REPLACE
STRIPE_PROPLUS_YEARLY_PRICE_ID=price_REPLACE

# Public site URL for Stripe checkout success/cancel redirects (no trailing slash).
FRONTEND_BASE_URL=https://stock-ai.pro

# --- Email ---
RESEND_API_KEY=re_REPLACE

# --- Market data providers ---
POLYGON_API_KEY=
# Repeat fetch-quotes BullMQ job (every 5 min). Keep false until provider entitlement/canary is approved.
# This is separate from MARKET_SIGNALS_ALLOW_POLYGON_SCHEDULER (MarketSignals ingestion scheduler).
POLYGON_LIVE_QUOTES_ENABLED=false
EODHD_API_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_API_KEY=

# --- AI (optional features) ---
ANTHROPIC_API_KEY=

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

# --- Internal / ops guards ---
# Used by MarketSignals ops routes (admin JWT OR this header). Generate a strong random value.
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_TOKEN

# --- MarketSignals scheduler (KEEP DISABLED until canary sign-off) ---
# MUST stay false/unset in production until ops runbook sign-off.
# See docs/market-signals-ops-runbook.md
MARKET_SIGNALS_SCHEDULER_ENABLED=false

# Comma-separated providers when scheduler is enabled (default in code: EODHD_INSIDER_ACTIVITY only).
# MARKET_SIGNALS_SCHEDULER_PROVIDERS=EODHD_INSIDER_ACTIVITY

# Polygon scheduler: keep false unless GET /api/v1/market-signals/ops/provider-check?provider=POLYGON
# confirms live entitlement (not merely a valid API key).
MARKET_SIGNALS_ALLOW_POLYGON_SCHEDULER=false

# Optional scheduler tuning (only when MARKET_SIGNALS_SCHEDULER_ENABLED=true):
# MARKET_SIGNALS_SCHEDULER_TICKERS=AAPL,MSFT,NVDA
# MARKET_SIGNALS_SCHEDULER_INTERVAL_MINUTES=240
# MARKET_SIGNALS_SCHEDULER_MAX_TICKERS=25
# MARKET_SIGNALS_WORKER_CONCURRENCY=2

# SEC EDGAR requires a descriptive User-Agent (company + contact email). Required for SEC_FILINGS fetcher.
# SEC_USER_AGENT=StockAI Pro/1.0 (contact@yourdomain.com)

# --- Affiliate geo (optional override) ---
# IPAPI_BASE_URL=https://ipapi.co

# --- Frontend build-time (set in CI or apps/frontend Docker build ARG, not runtime API) ---
# GA loads only after cookie consent in the SPA; measurement ID is baked into frontend bundle at build.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_API_BASE=/api

