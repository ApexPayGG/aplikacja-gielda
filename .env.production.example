# Copy to .env.production, replace PASSWORD / keys, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# Use the same POSTGRES_PASSWORD in DATABASE_URL and below (or change default in compose).

NODE_ENV=production
PORT=3000

# Must match POSTGRES_PASSWORD (replace changeme with a strong secret everywhere).
DATABASE_URL=postgresql://postgres:changeme@timescaledb:5432/stockai

REDIS_URL=redis://redis:6379

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Market data
POLYGON_API_KEY=
EODHD_API_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_API_KEY=

# AI
ANTHROPIC_API_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
