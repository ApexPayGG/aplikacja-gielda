# Frontend environment template (copy to .env.local for local overrides)

# API base - dev proxy uses /api
VITE_API_BASE=/api

# GA4 measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=

# EUR Stripe checkout on /pricing - keep false until STRIPE_PRICE_*_EUR are set and smoke-tested
VITE_EUR_CHECKOUT_ENABLED=false
