generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DividendAlertType {
  dividend_cut
  dividend_growth
  anomaly
  sector_change
}

enum DividendTrendDirection {
  up
  down
  stable
}

enum TradeSide {
  BUY
  SELL
}

model User {
  id                  String              @id @default(cuid())
  createdAt           DateTime            @default(now()) @map("created_at")
  virtual_trades      VirtualTrade[]
  portfolio_snapshots PortfolioSnapshot[]

  @@map("users")
}

model Company {
  symbol      String   @id
  name        String
  sector      String
  industry    String
  logoUrl     String?
  description String?
  webUrl      String?  @map("web_url")
  createdAt   DateTime @default(now())

  quotes               Quote[]
  news                 News[]
  technicalIndicators  TechnicalIndicator[]
  dividends            Dividend[]
  dividendHistories    DividendHistory[]
  dividendAlerts              DividendAlert[]
  dividendIntelligence        DividendIntelligence?
  dividendSustainabilityScore DividendSustainabilityScore?

  @@map("companies")
}

model Quote {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    BigInt
  source    String
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@unique([symbol, timestamp, source])
  @@index([symbol, timestamp(sort: Desc)], map: "idx_quotes_company_id_timestamp_desc")
  @@map("quotes")
}

model News {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  title     String
  url       String   @db.Text
  sentiment String?
  source    String
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@index([symbol, timestamp(sort: Desc)], map: "idx_news_company_id_published_at_desc")
  @@map("news")
}

model TechnicalIndicator {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  indicator String
  value     Decimal  @db.Decimal(24, 8)
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@unique([symbol, timestamp, indicator])
  @@index([symbol, timestamp(sort: Desc)], map: "idx_indicators_company_id_date_desc")
  @@map("technical_indicators")
}

/// Metryki Phase 11: `eps`, `fcf`, `ocf`, `shares_outstanding` (per `year` fiskalny), `eps_ttm` (`year=0`).
/// `lastUpdated` = czas ostatniego upsertu (EODHD nie dostarcza osobnego `createdAt` per wiersz).
model Fundamental {
  id          BigInt   @id @default(autoincrement())
  symbol      String
  metric      String
  year        Int      @default(0)
  value       Decimal  @db.Decimal(24, 8)
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@unique([symbol, metric, year])
  @@index([symbol])
  @@map("fundamentals")
}

model Dividend {
  id        String   @id @default(cuid())
  symbol    String   @db.VarChar(10)
  exDate    DateTime @map("ex_date")
  payDate   DateTime @map("pay_date")
  amount    Float
  currency  String   @default("USD")
  yield     Float?   @map("dividend_yield")
  frequency String?
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol, exDate])
  @@index([symbol, payDate])
  @@map("dividends")
}

model DividendHistory {
  id          String  @id @default(cuid())
  symbol      String  @db.VarChar(10)
  year        Int
  totalAmount Float   @map("total_amount")
  growthYoY   Float?  @map("growth_yoy")
  cagr5Y      Float?  @map("cagr_5y")
  cagr10Y     Float?  @map("cagr_10y")
  company     Company @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@unique([symbol, year])
  @@index([symbol, year])
  @@map("dividend_histories")
}

model DividendAlert {
  id         String            @id @default(cuid())
  symbol     String            @db.VarChar(10)
  alertType  DividendAlertType @map("alert_type")
  severity   Int
  confidence Float
  message    String            @db.Text
  metric     String?           @db.VarChar(64)
  value      Float?
  createdAt  DateTime          @default(now()) @map("created_at")
  company    Company           @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol, createdAt])
  @@map("dividend_alerts")
}

model DividendIntelligence {
  id               String                 @id @default(cuid())
  symbol           String                 @unique @db.VarChar(10)
  safetyScore      Int                    @map("safety_score")
  safetyReason     String                 @map("safety_reason") @db.Text
  trendDirection   DividendTrendDirection @map("trend_direction")
  sectorPercentile Int                    @map("sector_percentile")
  lastAnalyzedAt   DateTime               @map("last_analyzed_at")
  company          Company                @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol])
  @@map("dividend_intelligence")
}

/// Phase 11 Sprint 3 — snapshot deterministycznego scoringu zrównoważenia dywidendy.
model DividendSustainabilityScore {
  id                 String   @id @default(cuid())
  symbol             String   @unique @db.VarChar(10)
  finalScore         Int      @map("final_score")
  payoutScore        Int      @map("payout_score")
  coverageScore      Int      @map("coverage_score")
  consistencyScore  Int      @map("consistency_score")
  payoutRatio        Float?   @map("payout_ratio")
  fcfCoverage        Float?   @map("fcf_coverage")
  explanation        String   @db.Text
  componentsJson     String?  @map("components_json") @db.Text
  lastCalculatedAt   DateTime @default(now()) @map("last_calculated_at")
  modelVersion       String   @default("1.0") @map("model_version")
  company            Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol, lastCalculatedAt])
  @@map("dividend_sustainability_scores")
}

model Signal {
  id        String @id @default(cuid())
  ticker    String
  exchange  String

  // Detection metadata
  pattern_type   String
  confidence     Int
  technical_data Json

  // Backtest data
  historical_count Int?
  win_rate         Float?
  avg_return_10d   Float?
  max_drawdown     Float?

  // AI fields (populated later in Phase 6)
  brief_pl          String?
  brief_en          String?
  score             Int?
  scoring_reasoning String?

  // Meta
  created_at     DateTime @default(now())
  expires_at     DateTime
  user_triggered Boolean  @default(false)

  @@index([ticker, created_at])
  @@index([exchange, created_at])
  @@index([expires_at])
}

model VirtualTrade {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  ticker    String
  exchange  String
  side      TradeSide
  quantity  Float
  price     Float
  executed_at DateTime @default(now())
  signal_id String?
  notes     String?
  pnl_amount Float?
  pnl_pct   Float?

  @@index([userId, executed_at])
}

model PortfolioSnapshot {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  date             DateTime @default(now())
  total_value      Float
  cash             Float
  holdings         Json
  pnl_daily        Float
  pnl_total        Float
  pnl_pct          Float
  benchmark_wig    Float?
  benchmark_sp500  Float?

  @@index([userId, date])
}
