generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  symbol      String   @id
  name        String
  sector      String
  industry    String
  logoUrl     String?
  description String?
  webUrl      String?  @map("web_url")
  createdAt   DateTime @default(now())

  quotes               Quote[]
  news                 News[]
  technicalIndicators  TechnicalIndicator[]

  @@map("companies")
}

model Quote {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    BigInt
  source    String
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@unique([symbol, timestamp, source])
  @@index([symbol, timestamp(sort: Desc)])
  @@map("quotes")
}

model News {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  title     String
  url       String   @db.Text
  sentiment String?
  source    String
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@index([symbol, timestamp(sort: Desc)])
  @@map("news")
}

model TechnicalIndicator {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  indicator String
  value     Decimal  @db.Decimal(24, 8)
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@unique([symbol, timestamp, indicator])
  @@index([symbol, timestamp(sort: Desc)])
  @@map("technical_indicators")
}

model Fundamental {
  id          BigInt   @id @default(autoincrement())
  symbol      String
  metric      String
  value       Decimal  @db.Decimal(24, 8)
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@unique([symbol, metric])
  @@index([symbol])
  @@map("fundamentals")
}
