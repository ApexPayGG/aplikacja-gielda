generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// OHLCV quotes — hypertable on `timestamp` (see prisma/migrations/init/hypertables.sql after `db push`).
model Quote {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    BigInt
  source    String

  @@id([timestamp, id])
  @@unique([symbol, timestamp, source])
  @@index([symbol, timestamp(sort: Desc)])
  @@map("quotes")
}

/// News items — hypertable on `timestamp`.
model News {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  title     String
  url       String   @db.Text
  sentiment String?
  source    String

  @@id([timestamp, id])
  @@index([symbol, timestamp(sort: Desc)])
  @@map("news")
}

/// Technical indicators — hypertable on `timestamp`.
model TechnicalIndicator {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  indicator String
  value     Decimal  @db.Decimal(24, 8)

  @@id([timestamp, id])
  @@unique([symbol, timestamp, indicator])
  @@index([symbol, timestamp(sort: Desc)])
  @@map("technical_indicators")
}

/// Point-in-time fundamentals (not a hypertable).
model Fundamental {
  id          BigInt   @id @default(autoincrement())
  symbol      String
  metric      String
  value       Decimal  @db.Decimal(24, 8)
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@unique([symbol, metric])
  @@index([symbol])
  @@map("fundamentals")
}
