generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DividendAlertType {
  dividend_cut
  dividend_growth
  anomaly
  sector_change
}

enum DividendTrendDirection {
  up
  down
  stable
}

enum TradeSide {
  BUY
  SELL
}

enum PaperTradeDirection {
  LONG
  SHORT
}

enum PaperTradeStatus {
  OPEN
  CLOSED
}

enum ExitAction {
  HOLD
  EXIT_NOW
  TIGHTEN_SL
  SCALE_OUT
}

enum ExitUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlphaWindowType {
  EARNINGS_CYCLE
  SEASONAL
  SECTOR_ROTATION
  REGIME_SHIFT
}

enum AlpacaMode {
  PAPER
  LIVE
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  emailVerified         Boolean                @default(false) @map("email_verified")
  verifyToken           String?                @map("verify_token")
  verifyTokenExp        DateTime?              @map("verify_token_exp")
  passwordResetToken    String?                @map("password_reset_token")
  passwordResetTokenExp DateTime?              @map("password_reset_token_exp")
  passwordHash          String                 @map("password_hash")
  name                  String?
  language              String?                @default("pl")
  timezone              String?                @default("Europe/Warsaw")
  avatarUrl             String?                @map("avatar_url")
  tier                  String                 @default("FREE")
  role                  String                 @default("USER")
  stripeCustomerId      String?                @map("stripe_customer_id")
  subscriptionStatus    String?                @default("free") @map("subscription_status")
  subscriptionEnd       DateTime?              @map("subscription_end")
  discordWebhook        String?
  telegramChatId        String?
  notifySignals         Boolean                @default(true)
  notifyDividends       Boolean                @default(true)
  minSignalScore        Int                    @default(70)
  createdAt             DateTime               @default(now()) @map("created_at")
  lastLoginAt           DateTime?              @map("last_login_at")
  onboardingEmail2Sent  Boolean                @default(false) @map("onboarding_email2_sent")
  onboardingEmail3Sent  Boolean                @default(false) @map("onboarding_email3_sent")
  virtual_trades        VirtualTrade[]
  portfolio_snapshots   PortfolioSnapshot[]
  affiliateClicks       AffiliateClick[]
  affiliateConversions  AffiliateConversion[]
  emotionJournalEntries EmotionJournalEntry[]
  psycheSnapshots       PsycheSnapshot[]
  autopilotSettings     UserAutopilotSettings?

  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@map("notifications")
}

model Watchlist {
  id      String   @id @default(cuid())
  userId  String
  symbol  String
  addedAt DateTime @default(now())

  @@unique([userId, symbol])
  @@map("watchlists")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

model Company {
  symbol      String   @id
  name        String
  exchange    String   @default("US")
  sector      String
  industry    String
  logoUrl     String?
  description String?
  webUrl      String?  @map("web_url")
  createdAt   DateTime @default(now())

  quotes                      Quote[]
  news                        News[]
  technicalIndicators         TechnicalIndicator[]
  dividends                   Dividend[]
  dividendHistories           DividendHistory[]
  dividendAlerts              DividendAlert[]
  dividendIntelligence        DividendIntelligence?
  dividendSustainabilityScore DividendSustainabilityScore?

  @@map("companies")
}

model Quote {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    BigInt
  source    String
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@unique([symbol, timestamp, source])
  @@index([symbol, timestamp(sort: Desc)], map: "idx_quotes_company_id_timestamp_desc")
  @@map("quotes")
}

/// Live Polygon snapshots (5‑minute ingest job). Separate from legacy OHLC `quotes` tied to `companies`.
model LiveQuote {
  id             BigInt   @id @default(autoincrement())
  ticker         String   @db.VarChar(10)
  price          Decimal  @db.Decimal(10, 2)
  open           Decimal? @db.Decimal(10, 2)
  high           Decimal? @db.Decimal(10, 2)
  low            Decimal? @db.Decimal(10, 2)
  close          Decimal? @db.Decimal(10, 2)
  volume         BigInt?
  vwap           Decimal? @db.Decimal(10, 2)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(64)
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ticker])
  @@index([createdAt(sort: Desc)])
  @@map("live_quotes")
}

model News {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  title     String
  url       String   @db.Text
  sentiment String?
  source    String
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@index([symbol, timestamp(sort: Desc)], map: "idx_news_company_id_published_at_desc")
  @@map("news")
}

model TechnicalIndicator {
  id        BigInt   @default(autoincrement())
  symbol    String
  timestamp DateTime
  indicator String
  value     Decimal  @db.Decimal(24, 8)
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@id([timestamp, id])
  @@unique([symbol, timestamp, indicator])
  @@index([symbol, timestamp(sort: Desc)], map: "idx_indicators_company_id_date_desc")
  @@map("technical_indicators")
}

/// Metryki Phase 11: `eps`, `fcf`, `ocf`, `shares_outstanding` (per `year` fiskalny), `eps_ttm` (`year=0`).
/// `lastUpdated` = czas ostatniego upsertu (EODHD nie dostarcza osobnego `createdAt` per wiersz).
model Fundamental {
  id          BigInt   @id @default(autoincrement())
  symbol      String
  metric      String
  year        Int      @default(0)
  value       Decimal  @db.Decimal(24, 8)
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@unique([symbol, metric, year])
  @@index([symbol])
  @@map("fundamentals")
}

/// Premium Company Analysis — historical setup snapshots for twin matching.
model StockSetupHistory {
  id             String                    @id @default(cuid())
  symbol         String
  snapshotDate   DateTime
  priceClose     Float?
  priceChange5d  Float?
  priceChange20d Float?
  volumeRatio    Float?
  rsi14          Float?
  outcome5d      Float?
  outcome20d     Float?
  outcome60d     Float?
  embedding      Unsupported("vector(9)")?
  createdAt      DateTime                  @default(now())

  @@unique([symbol, snapshotDate])
  @@map("stock_setups_history")
}

model Dividend {
  id        String   @id @default(cuid())
  symbol    String   @db.VarChar(10)
  exDate    DateTime @map("ex_date")
  payDate   DateTime @map("pay_date")
  amount    Float
  currency  String   @default("USD")
  yield     Float?   @map("dividend_yield")
  frequency String?
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol, exDate])
  @@index([symbol, payDate])
  @@map("dividends")
}

model DividendHistory {
  id          String  @id @default(cuid())
  symbol      String  @db.VarChar(10)
  year        Int
  totalAmount Float   @map("total_amount")
  growthYoY   Float?  @map("growth_yoy")
  cagr5Y      Float?  @map("cagr_5y")
  cagr10Y     Float?  @map("cagr_10y")
  company     Company @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@unique([symbol, year])
  @@index([symbol, year])
  @@map("dividend_histories")
}

model DividendAlert {
  id         String            @id @default(cuid())
  symbol     String            @db.VarChar(10)
  alertType  DividendAlertType @map("alert_type")
  severity   Int
  confidence Float
  message    String            @db.Text
  metric     String?           @db.VarChar(64)
  value      Float?
  createdAt  DateTime          @default(now()) @map("created_at")
  company    Company           @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol, createdAt])
  @@map("dividend_alerts")
}

model DividendIntelligence {
  id               String                 @id @default(cuid())
  symbol           String                 @unique @db.VarChar(10)
  safetyScore      Int                    @map("safety_score")
  safetyReason     String                 @map("safety_reason") @db.Text
  trendDirection   DividendTrendDirection @map("trend_direction")
  sectorPercentile Int                    @map("sector_percentile")
  lastAnalyzedAt   DateTime               @map("last_analyzed_at")
  company          Company                @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol])
  @@map("dividend_intelligence")
}

/// Phase 11 Sprint 3 — snapshot deterministycznego scoringu zrównoważenia dywidendy.
model DividendSustainabilityScore {
  id               String   @id @default(cuid())
  symbol           String   @unique @db.VarChar(10)
  finalScore       Int      @map("final_score")
  payoutScore      Int      @map("payout_score")
  coverageScore    Int      @map("coverage_score")
  consistencyScore Int      @map("consistency_score")
  payoutRatio      Float?   @map("payout_ratio")
  fcfCoverage      Float?   @map("fcf_coverage")
  explanation      String   @db.Text
  componentsJson   String?  @map("components_json") @db.Text
  lastCalculatedAt DateTime @default(now()) @map("last_calculated_at")
  modelVersion     String   @default("1.0") @map("model_version")
  company          Company  @relation(fields: [symbol], references: [symbol], onUpdate: Cascade)

  @@index([symbol, lastCalculatedAt])
  @@map("dividend_sustainability_scores")
}

model Signal {
  id       String @id @default(cuid())
  ticker   String
  exchange String

  // Detection metadata
  pattern_type   String
  confidence     Int
  technical_data Json

  // Backtest data
  historical_count Int?
  win_rate         Float?
  avg_return_10d   Float?
  max_drawdown     Float?

  // AI fields (populated later in Phase 6)
  brief_pl            String?
  brief_en            String?
  score               Int?
  scoring_reasoning   String?
  marketRegime        String?
  regimeConfidence    Int?
  narrativeHeadline   String?
  narrativeBody       String?
  narrativeRisk       String?
  narrativeConfidence String?

  // Meta
  created_at     DateTime @default(now())
  expires_at     DateTime
  user_triggered Boolean  @default(false)

  tradeReactions TradeReaction[]

  @@index([ticker, created_at])
  @@index([exchange, created_at])
  @@index([expires_at])
}

model DlqEvent {
  id        Int      @default(autoincrement())
  jobId     String   @map("job_id")
  ticker    String
  attempt   Int
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@id([id, createdAt])
  @@index([createdAt(sort: Desc)], map: "dlq_events_created_at_idx")
  @@index([jobId], map: "dlq_events_job_id_idx")
  @@map("dlq_events")
}

model VirtualTrade {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  ticker      String
  exchange    String
  side        TradeSide
  quantity    Float
  price       Float
  executed_at DateTime  @default(now())
  signal_id   String?
  notes       String?
  pnl_amount  Float?
  pnl_pct     Float?

  @@index([userId, executed_at])
}

model PortfolioSnapshot {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  date            DateTime @default(now())
  total_value     Float
  cash            Float
  holdings        Json
  pnl_daily       Float
  pnl_total       Float
  pnl_pct         Float
  benchmark_wig   Float?
  benchmark_sp500 Float?

  @@index([userId, date])
}

model UserSettings {
  id              String  @id @default(cuid())
  userId          String  @unique
  discordWebhook  String?
  mentorMode      Boolean @default(false)
  digestEmail     String?
  alpacaApiKey    String?
  alpacaApiSecret String?
  alpacaMode      String? @default("paper")
  taxCountry      String? @default("PL")

  @@map("user_settings")
}

/// Autonomous agent (Autopilot) — encrypted BYOK Alpaca credentials and hard Safe Guard risk caps.
/// Legacy plaintext Alpaca fields remain on `UserSettings` until migrated by application code.
model UserAutopilotSettings {
  id                       String     @id @default(cuid())
  userId                   String     @unique @map("user_id")
  isAutopilotEnabled       Boolean    @default(false) @map("is_autopilot_enabled")
  alpacaMode               AlpacaMode @default(PAPER) @map("alpaca_mode")
  alpacaApiKeyEncrypted    String?    @map("alpaca_api_key_encrypted") @db.Text
  alpacaApiSecretEncrypted String?    @map("alpaca_api_secret_encrypted") @db.Text
  maxCapitalPerTradePct    Decimal    @default(0.02) @map("max_capital_per_trade_pct") @db.Decimal(6, 4)
  maxDailyDrawdownPct      Decimal    @default(0.05) @map("max_daily_drawdown_pct") @db.Decimal(6, 4)
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAutopilotEnabled], map: "idx_user_autopilot_settings_enabled")
  @@map("user_autopilot_settings")
}

model AffiliateBroker {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  displayName           String   @map("display_name")
  logoUrl               String?  @map("logo_url")
  partnerId             String   @map("partner_id")
  affiliateProgramUrl   String?  @map("affiliate_program_url")
  baseUrl               String   @map("base_url")
  tickerUrlTemplate     String?  @map("ticker_url_template")
  clickIdParam          String   @default("cid") @map("click_id_param")
  attributionMethod     String   @map("attribution_method")
  supportedCountries    String[] @default([]) @map("supported_countries")
  supportedMarkets      String[] @default([]) @map("supported_markets")
  primaryLanguage       String?  @map("primary_language")
  commissionModel       String   @map("commission_model")
  commissionCpaAmount   Decimal? @map("commission_cpa_amount") @db.Decimal(10, 2)
  commissionRevsharePct Decimal? @map("commission_revshare_pct") @db.Decimal(5, 2)
  commissionCurrency    String   @default("EUR") @map("commission_currency")
  conversionTracking    String?  @map("conversion_tracking")
  apiEndpoint           String?  @map("api_endpoint")
  webhookSecret         String?  @map("webhook_secret")
  isActive              Boolean  @default(true) @map("is_active")
  priority              Int      @default(100)
  legalDisclaimer       Json?    @map("legal_disclaimer")
  riskWarning           Json?    @map("risk_warning")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  clicks      AffiliateClick[]
  conversions AffiliateConversion[]
  payouts     AffiliatePayout[]

  @@map("affiliate_brokers")
}

model AffiliateClick {
  id             String   @id @default(cuid())
  clickId        String   @unique @map("click_id")
  userId         String?  @map("user_id")
  brokerId       String   @map("broker_id")
  sourcePage     String?  @map("source_page")
  sourceTicker   String?  @map("source_ticker")
  sourceSignalId String?  @map("source_signal_id")
  contextData    Json?    @map("context_data")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  countryCode    String?  @map("country_code")
  language       String?
  deviceType     String?  @map("device_type")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  redirectUrl    String   @map("redirect_url")
  clickedAt      DateTime @default(now()) @map("clicked_at")

  broker            AffiliateBroker       @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversionRefs    AffiliateConversion[] @relation("AffiliateConversionClickRef")
  conversionMatches AffiliateConversion[] @relation("AffiliateConversionMatchedClick")

  @@index([userId], map: "idx_affiliate_clicks_user")
  @@index([brokerId], map: "idx_affiliate_clicks_broker")
  @@index([clickedAt], map: "idx_affiliate_clicks_clicked_at")
  @@index([sourceTicker], map: "idx_affiliate_clicks_source_ticker")
  @@map("affiliate_clicks")
}

model AffiliateConversion {
  id                    String    @id @default(cuid())
  clickIdRef            String?   @map("click_id_ref")
  brokerId              String    @map("broker_id")
  userId                String?   @map("user_id")
  externalUserId        String?   @map("external_user_id")
  conversionType        String    @map("conversion_type")
  conversionStatus      String    @map("conversion_status")
  commissionAmount      Decimal?  @map("commission_amount") @db.Decimal(10, 2)
  commissionCurrency    String?   @map("commission_currency")
  ftdAmount             Decimal?  @map("ftd_amount") @db.Decimal(12, 2)
  attributionWindowDays Int?      @map("attribution_window_days")
  matchedClickId        String?   @map("matched_click_id")
  conversionDate        DateTime  @map("conversion_date") @db.Date
  recordedAt            DateTime  @default(now()) @map("recorded_at")
  paidAt                DateTime? @map("paid_at")
  rawBrokerData         Json?     @map("raw_broker_data")

  broker     AffiliateBroker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  clickByRef AffiliateClick? @relation("AffiliateConversionClickRef", fields: [clickIdRef], references: [clickId], onDelete: SetNull)
  clickById  AffiliateClick? @relation("AffiliateConversionMatchedClick", fields: [matchedClickId], references: [id], onDelete: SetNull)

  @@index([brokerId, conversionDate], map: "idx_affiliate_conversions_broker_date")
  @@index([conversionStatus], map: "idx_affiliate_conversions_status")
  @@map("affiliate_conversions")
}

model AffiliatePayout {
  id                String    @id @default(cuid())
  brokerId          String    @map("broker_id")
  payoutPeriodStart DateTime  @map("payout_period_start") @db.Date
  payoutPeriodEnd   DateTime  @map("payout_period_end") @db.Date
  totalAmount       Decimal   @map("total_amount") @db.Decimal(12, 2)
  currency          String?
  conversionCount   Int?      @map("conversion_count")
  status            String    @default("pending")
  paidAt            DateTime? @map("paid_at")
  referenceNumber   String?   @map("reference_number")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")

  broker AffiliateBroker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@map("affiliate_payouts")
}

model PaperTrade {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  ticker       String
  direction    PaperTradeDirection
  entryPrice   Float               @map("entry_price")
  exitPrice    Float?              @map("exit_price")
  quantity     Float
  entryAt      DateTime            @default(now()) @map("entry_at")
  exitAt       DateTime?           @map("exit_at")
  status       PaperTradeStatus
  pnl          Float?
  pnlPct       Float?              @map("pnl_pct")
  signalId     String?             @map("signal_id")
  marketRegime String?             @map("market_regime")

  tradeReactions TradeReaction[]

  @@index([userId, status, entryAt])
  @@index([userId, exitAt])
  @@map("paper_trades")
}

model TradeReaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tradeId   String?  @map("trade_id")
  signalId  String?  @map("signal_id")
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  paperTrade PaperTrade? @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  signal     Signal?     @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([tradeId, createdAt])
  @@index([signalId, createdAt])
  @@map("trade_reactions")
}

model TrackRecord {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  publicHash    String   @unique @map("public_hash")
  winRate       Float    @map("win_rate")
  totalTrades   Int      @map("total_trades")
  avgReturn     Float    @map("avg_return")
  bestTradePct  Float    @map("best_trade_pct")
  worstTradePct Float    @map("worst_trade_pct")
  generatedAt   DateTime @default(now()) @map("generated_at")

  @@index([userId, generatedAt])
  @@map("track_records")
}

model SkillProgress {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  skillId    String   @map("skill_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  @@unique([userId, skillId])
  @@index([userId, unlockedAt])
  @@map("skill_progress")
}

model BehavioralSnapshot {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  biases              Json
  avgWinPct           Float    @map("avg_win_pct")
  avgLossPct          Float    @map("avg_loss_pct")
  avgHoldingWinHours  Float    @map("avg_holding_win_hours")
  avgHoldingLossHours Float    @map("avg_holding_loss_hours")
  calculatedAt        DateTime @default(now()) @map("calculated_at")

  @@index([userId, calculatedAt])
  @@map("behavioral_snapshots")
}

model MistakeLibrary {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  tradeId     String   @map("trade_id")
  symbol      String
  pnl         Float
  type        String
  explanation String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([tradeId])
  @@map("mistake_library")
}

/// Immutable audit entries: e.g. proceeding after Pre-Mortem, or closing at a loss.
model DecisionReceipt {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  paperTradeId String?  @map("paper_trade_id")
  kind         String
  symbol       String
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("decision_receipts")
}

model EmotionJournalEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  emotion   String
  ticker    String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("emotion_journal_entries")
}

model PsycheSnapshot {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  fomoScore    Int      @default(50) @map("fomo_score")
  discipline   Int      @default(50)
  greedControl Int      @default(50) @map("greed_control")
  patience     Int      @default(50)
  growthScore  Int      @default(50) @map("growth_score")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("psyche_snapshots")
}

model EmotionalEvent {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  clickRate       Float    @map("click_rate")
  tradeFrequency  Float    @map("trade_frequency")
  avgDecisionTime Float    @map("avg_decision_time")
  stressDetected  Boolean  @map("stress_detected")
  suggestion      String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("emotional_events")
}

model ExitSignal {
  id        String      @id @default(cuid())
  tradeId   String      @map("trade_id")
  ticker    String
  action    ExitAction
  urgency   ExitUrgency
  pnlPct    Float       @map("pnl_pct")
  reason    String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([tradeId, createdAt])
  @@index([ticker, createdAt])
  @@map("exit_signals")
}

model AlphaWindow {
  id                  String          @id @default(cuid())
  ticker              String
  windowStart         DateTime        @map("window_start")
  windowEnd           DateTime        @map("window_end")
  type                AlphaWindowType
  probabilityScore    Int             @map("probability_score")
  historicalAvgReturn Float           @map("historical_avg_return")
  description         String
  aiNote              String          @map("ai_note")
  createdAt           DateTime        @default(now()) @map("created_at")

  @@index([ticker, createdAt])
  @@index([type, probabilityScore])
  @@map("alpha_windows")
}

model MirrorPermission {
  id           String  @id @default(cuid())
  traderId     String  @unique @map("trader_id")
  enabled      Boolean @default(false)
  revenueShare Float   @default(0) @map("revenue_share")
  followers    Int     @default(0)

  @@map("mirror_permissions")
}

model MirrorFollower {
  id         String   @id @default(cuid())
  followerId String   @map("follower_id")
  traderId   String   @map("trader_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([followerId, traderId])
  @@index([followerId])
  @@index([traderId])
  @@map("mirror_followers")
}

model TraderProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  topBiases      String[] @default([]) @map("top_biases")
  tradingStyle   String?  @map("trading_style")
  goodConditions String?  @map("good_conditions")
  badConditions  String?  @map("bad_conditions")
  growthScore    Int      @default(0) @map("growth_score")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("trader_profiles")
}

model DecisionLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  tradeId        String?  @map("trade_id")
  symbol         String
  action         String
  mood           String?
  reasoning      String?
  planCompliance Boolean? @map("plan_compliance")
  outcome        Float?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("decision_logs")
}

model TradingRule {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  rule      String
  active    Boolean  @default(true)
  breaches  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, active])
  @@map("trading_rules")
}

model RuleBreach {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ruleId    String   @map("rule_id")
  context   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([ruleId])
  @@map("rule_breaches")
}

model DailyCheckIn {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mood      Int
  plan      String?
  riskLevel String?  @map("risk_level")
  aiMessage String?  @map("ai_message")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("daily_check_ins")
}

model PostTradeReflection {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  tradeId      String   @unique @map("trade_id")
  followedPlan Boolean  @map("followed_plan")
  emotion      String?
  lesson       String?
  aiInsight    String?  @map("ai_insight")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("post_trade_reflections")
}

model WeeklyReview {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  weekStart   DateTime @map("week_start")
  answers     Json
  aiLetter    String?  @map("ai_letter")
  growthScore Int?     @map("growth_score")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, weekStart])
  @@index([userId, weekStart(sort: Desc)])
  @@map("weekly_reviews")
}

/// Event Risk Radar — shared market events (earnings, dividends, macro, etc.)
model MarketEvent {
  id           String          @id @default(cuid())
  symbol       String?
  exchange     String?
  eventType    String          @map("event_type")
  eventSubtype String?         @map("event_subtype")
  eventDate    DateTime        @map("event_date") @db.Date
  eventTime    String?         @map("event_time")
  importance   String          @default("medium")
  title        String
  summary      String?
  source       String
  sourceUrl    String?         @map("source_url")
  dedupeKey    String          @unique @map("dedupe_key")
  payload      Json?
  fiscalPeriod String?         @map("fiscal_period")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deliveries   EventDelivery[]

  @@index([symbol, eventDate])
  @@index([eventDate, importance])
  @@index([eventType, eventDate])
  @@map("market_events")
}

model EventSubscription {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  symbol        String?
  watchlistOnly Boolean  @default(true) @map("watchlist_only")
  eventTypes    String[] @default([]) @map("event_types")
  channels      String[] @default(["in_app"])
  minImportance String   @default("medium") @map("min_importance")
  daysBefore    Int[]    @default([7, 3, 1, 0]) @map("days_before")
  webhookUrl    String?  @map("webhook_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("event_subscriptions")
}

model EventDelivery {
  id        String      @id @default(cuid())
  eventId   String      @map("event_id")
  userId    String      @map("user_id")
  channel   String
  status    String      @default("pending")
  attempts  Int         @default(0)
  lastError String?     @map("last_error")
  dedupeKey String      @unique @map("dedupe_key")
  sentAt    DateTime?   @map("sent_at")
  createdAt DateTime    @default(now()) @map("created_at")
  event     MarketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("event_deliveries")
}
