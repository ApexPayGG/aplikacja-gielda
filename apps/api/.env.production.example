# StockAI Pro API - production env (template only, NO REAL SECRETS)
#
# Canonical full template: ../../.env.production.example (repo root)
# Production VPS path:       /root/aplikacja-gielda/.env.production
# Smoke checklist:           ../../docs/production-launch-smoke-checklist.md
#
# The API container loads this file via docker-compose `env_file: .env.production`.
# Keep DATABASE_URL POSTGRES_PASSWORD and POSTGRES_PASSWORD in sync.

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:REPLACE_STRONG_PASSWORD@timescaledb:5432/stockai
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# 64 hex chars / 32 bytes - required for Autopilot credential encryption
ENCRYPTION_SECRET=REPLACE_WITH_64_HEX_CHARS

STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE
STRIPE_PRO_YEARLY_PRICE_ID=price_REPLACE
STRIPE_PROPLUS_MONTHLY_PRICE_ID=price_REPLACE
STRIPE_PROPLUS_YEARLY_PRICE_ID=price_REPLACE
FRONTEND_BASE_URL=https://stock-ai.pro

RESEND_API_KEY=re_REPLACE
POLYGON_API_KEY=
EODHD_API_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

INTERNAL_API_KEY=REPLACE_WITH_RANDOM_TOKEN
MARKET_SIGNALS_SCHEDULER_ENABLED=false
MARKET_SIGNALS_ALLOW_POLYGON_SCHEDULER=false
# SEC_USER_AGENT=StockAI Pro/1.0 (contact@yourdomain.com)

