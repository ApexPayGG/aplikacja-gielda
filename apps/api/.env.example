# Server

PORT=3000

NODE_ENV=development



# Database (TimescaleDB / Postgres)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockai



# Redis (BullMQ + API cache). Optional: protect GET /api/redis/stats in production.

REDIS_URL=redis://localhost:6379

# REDIS_STATS_SECRET=your-random-secret



# Market data

POLYGON_API_KEY=
# Polygon live quotes (fetch-quotes job). Keep ENABLED=false until provider entitlement is confirmed.
POLYGON_LIVE_QUOTES_ENABLED=false
# Explicit launch universe for live ingest (recommended for production canary). Comma-separated tickers.
POLYGON_LIVE_QUOTES_SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY,QQQ
# Optional cap on ticker count (env list or reference fallback).
POLYGON_TOP_STOCKS_LIMIT=25

EODHD_API_KEY=

# Event Risk Radar / Market Events Intelligence (set MARKET_EVENTS_ENABLED=0 to disable)
# MARKET_EVENTS_ENABLED=1
# MARKET_EVENTS_SYNC_HORIZON_DAYS=30
# MARKET_EVENTS_DIGEST_HOUR_UTC=7
# FMP_API_KEY= (optional future provider - earnings calendar)

# Dividends - hybrid EODHD + Finnhub (see docs/DIVIDEND_DATA_SOURCES.md)

# DIVIDEND_SYNC_SYMBOLS=AAPL,MSFT,JNJ

# DIVIDEND_SYNC_YEARS=10

# DIVIDEND_SYNC_DELAY_MS=600

# DIVIDEND_SYNC_USE_DB_TOP=1

# EODHD_DIVIDEND_EXCHANGE=.US

# Fundamentals (Phase 11 - EODHD /fundamentals -> Prisma `Fundamental`)

# Domyślnie: https://eodhd.com/api/fundamentals (override gdy EODHD wymaga innej ścieżki, np. v1.1)

# EODHD_FUNDAMENTALS_API_BASE=https://eodhd.com/api/fundamentals

# EODHD_FUNDAMENTALS_EXCHANGE=.US

# FUNDAMENTAL_SYNC_DELAY_MS=600

# FUNDAMENTAL_S1_LIMIT=10 (seed sync: `npm run fundamentals:sync:s1`)

# FUNDAMENTAL_TEST_SYMBOLS=AAPL,MSFT,JNJ (`npm run fundamentals:test:s1`)

# Sustainability scoring Sprint 2 (`npm run sustainability:test:s2`)

# SUSTAINABILITY_TEST_SYMBOLS=AAPL,MSFT,JNJ

# Opcjonalna wersja modelu zapisywana przy `saveSustainabilityScore` / populate S3

# SUSTAINABILITY_MODEL_VERSION=1.0

# FUNDAMENTAL_SYNC_SYMBOLS=AAPL,MSFT (override list for `npm run fundamentals:sync`; else DIVIDEND_SYNC_SYMBOLS / DB top)

# Fixed calendar start for both APIs (optional):

# EODHD_DIVIDEND_FROM_YEAR=2020

# DIVIDEND_EODHD_DEMO=1

# DIVIDEND_SEED_MOCK=false

ALPHA_VANTAGE_KEY=

FINNHUB_API_KEY=

ALPACA_API_KEY=

ALPACA_API_SECRET=

ALPACA_MODE=paper

# Affiliate geo lookup (ipapi.co free tier)
IPAPI_BASE_URL=https://ipapi.co



# AI

ANTHROPIC_API_KEY=
JWT_SECRET=change-me

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy USD Price IDs (webhook mapping for existing subscriptions only - not used for new EUR checkout)
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PROPLUS_MONTHLY_PRICE_ID=
STRIPE_PROPLUS_YEARLY_PRICE_ID=

# EUR Price IDs (PRICING.3 - required for new checkout; resolver: apps/api/src/config/stripeEurPricing.ts)
STRIPE_PRICE_PRO_MONTHLY_EUR=
STRIPE_PRICE_PRO_YEARLY_EUR=
STRIPE_PRICE_PRO_PLUS_MONTHLY_EUR=
STRIPE_PRICE_PRO_PLUS_YEARLY_EUR=
# Investor OS - documented; checkout returns 501 until tier is supported end-to-end
# STRIPE_PRICE_INVESTOR_OS_MONTHLY_EUR=
# STRIPE_PRICE_INVESTOR_OS_YEARLY_EUR=
FRONTEND_BASE_URL=http://localhost:5173



# Notifications (optional)

TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=



# Job logging (pino)

# LOG_LEVEL=info

