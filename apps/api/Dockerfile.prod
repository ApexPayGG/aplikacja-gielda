# syntax=docker/dockerfile:1
# Build from repository root (see docker-compose.prod.yml: context `.`, dockerfile `apps/api/Dockerfile.prod`).
FROM node:20-alpine AS build
WORKDIR /repo/apps/api

COPY packages/data /repo/packages/data
COPY packages/ai /repo/packages/ai
COPY packages/dividends /repo/packages/dividends
COPY apps/api/package.json apps/api/package-lock.json ./
COPY apps/api/prisma ./prisma
RUN npm ci

COPY apps/api/src ./src
COPY apps/api/tsconfig.json ./tsconfig.json
RUN npx prisma generate

FROM node:20-alpine AS runtime
WORKDIR /repo/apps/api
ENV NODE_ENV=production

COPY packages/data /repo/packages/data
COPY packages/ai /repo/packages/ai
COPY packages/dividends /repo/packages/dividends
COPY apps/api/package.json apps/api/package-lock.json ./
COPY apps/api/prisma ./prisma
RUN npm install --omit=dev \
  && npm install -g tsx

COPY --from=build /repo/apps/api/node_modules/.prisma /repo/apps/api/node_modules/.prisma
COPY --from=build /repo/apps/api/node_modules/@prisma /repo/apps/api/node_modules/@prisma
COPY apps/api/src ./src

EXPOSE 3000
CMD ["tsx", "src/index.ts"]
